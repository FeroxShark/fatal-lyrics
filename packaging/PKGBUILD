# Maintainer: FeroxShark <feroxshark@gmail.com>
pkgname=fatal-lyrics-git
pkgver=r1.0000000
pkgrel=1
pkgdesc="Synced Spotify lyrics as glitchy Win95 error dialogs, or a full-screen CRT takeover (Wayland overlay)"
arch=('any')
url="https://github.com/FeroxShark/fatal-lyrics"
license=('MIT')
depends=('quickshell' 'playerctl' 'python')
optdepends=('gtk3: ícono de bandeja del sistema' 'libayatana-appindicator: ícono de bandeja del sistema')
makedepends=('git')
provides=('fatal-lyrics')
conflicts=('fatal-lyrics')
source=("git+https://github.com/FeroxShark/fatal-lyrics.git")
sha256sums=('SKIP')

pkgver() {
  cd fatal-lyrics
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
  cd fatal-lyrics
  install -d "$pkgdir/usr/share/fatal-lyrics/shell"
  install -Dm644 shell/shell.qml "$pkgdir/usr/share/fatal-lyrics/shell/shell.qml"
  install -Dm644 shell/Crt.qml "$pkgdir/usr/share/fatal-lyrics/shell/Crt.qml"
  install -Dm644 shell/Motif.qml "$pkgdir/usr/share/fatal-lyrics/shell/Motif.qml"
  install -Dm644 shell/Ocean.qml "$pkgdir/usr/share/fatal-lyrics/shell/Ocean.qml"
  install -Dm644 shell/Pond.qml "$pkgdir/usr/share/fatal-lyrics/shell/Pond.qml"
  install -Dm644 shell/tune.qml "$pkgdir/usr/share/fatal-lyrics/shell/tune.qml"
  # los shaders van precompilados (.qsb); los .frag viajan como fuente
  install -Dm644 shell/crt.frag.qsb "$pkgdir/usr/share/fatal-lyrics/shell/crt.frag.qsb"
  install -Dm644 shell/crt.frag "$pkgdir/usr/share/fatal-lyrics/shell/crt.frag"
  install -Dm644 shell/ocean.frag.qsb "$pkgdir/usr/share/fatal-lyrics/shell/ocean.frag.qsb"
  install -Dm644 shell/ocean.frag "$pkgdir/usr/share/fatal-lyrics/shell/ocean.frag"
  install -Dm644 shell/pond.frag.qsb "$pkgdir/usr/share/fatal-lyrics/shell/pond.frag.qsb"
  install -Dm644 shell/pond.frag "$pkgdir/usr/share/fatal-lyrics/shell/pond.frag"
  install -Dm755 cartelitos.py "$pkgdir/usr/share/fatal-lyrics/cartelitos.py"
  # el código está en el paquete; cartelitos.py sólo delega
  for m in cartelitos/*.py; do
    install -Dm644 "$m" "$pkgdir/usr/share/fatal-lyrics/$m"
  done
  install -Dm755 bin/fatal "$pkgdir/usr/share/fatal-lyrics/bin/fatal"
  install -d "$pkgdir/usr/bin"
  ln -s /usr/share/fatal-lyrics/bin/fatal "$pkgdir/usr/bin/fatal"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 packaging/fatal.desktop "$pkgdir/usr/share/applications/fatal.desktop"
}
