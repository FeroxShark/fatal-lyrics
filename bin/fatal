#!/bin/bash
# fatal-lyrics — synced Spotify lyrics as Windows error dialogs.
# Relocatable: works from the cloned repo or installed at /usr/share/fatal-lyrics.
SELF="$(readlink -f "$0")"
BASE="${CARTELITOS_HOME:-$(dirname "$(dirname "$SELF")")}"
QML="$BASE/shell/shell.qml"
SETTINGS_QML="$BASE/shell/settings.qml"
DAEMON="$BASE/cartelitos.py"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/cartelitos/config.toml"

RUN="${XDG_RUNTIME_DIR:-/run/user/$UID}/cartelitos"
mkdir -p "$RUN" 2>/dev/null
QS_PID="$RUN/qs.pid"
D_PID="$RUN/daemon.pid"
# guardia de instancia única: flock sobre estos archivos (los toma el propio
# proceso, así que se suelta solo cuando muere — no hay lock viejo que limpiar)
QS_LOCK="$RUN/qs.lock"
D_LOCK="$RUN/daemon.lock"
# el daemon lo crea cuando ya escribió el flag del CRT de arranque (util.mark_ready)
D_READY="$RUN/daemon.ready"
QS_LOG="$RUN/qs.log"
D_LOG="$RUN/daemon.log"
# de dónde salió la letra del tema que suena: lo escribe el daemon (ver
# cartelitos/lyrics.py write_state), porque este proceso es corto y no tiene
# forma de preguntárselo — el socket va sólo del daemon al overlay
LYRICS="$RUN/lyrics"
# dónde vivían los PID antes de mudarlos al runtime: sirven para poder apagar
# una instancia que había arrancado con la versión vieja
OLD_QS_PID=/tmp/cartelitos-qs.pid
OLD_D_PID=/tmp/cartelitos-daemon.pid
SOCK="${XDG_RUNTIME_DIR:-/run/user/$UID}/cartelitos.sock"
# interruptor del modo CRT: un archivo, no el socket — apagarlo tiene que
# funcionar aunque el daemon esté colgado (el tubo tapa todas las pantallas)
CRT="${XDG_RUNTIME_DIR:-/run/user/$UID}/cartelitos-crt"
# `fatal crt setup`: otro archivo, mismo mecanismo — cada pantalla dibuja su
# número y su nombre, que es lo que hay que escribir en `[crt] order`
CRT_SETUP="${XDG_RUNTIME_DIR:-/run/user/$UID}/cartelitos-crt-setup"
# gesto de sync fino (T0.13): otro archivo, mismo motivo — este proceso es
# corto y se muere, el daemon (otro proceso) es el que tiene que verlo
SYNCF="${XDG_RUNTIME_DIR:-/run/user/$UID}/cartelitos-sync"
# modo karaoke (`fatal sing`): mismo mecanismo de archivo, pero acá el archivo
# es sólo el timbre — el estado vive en la perilla `[behavior] sing` del TOML,
# que es lo que el daemon manda al overlay y lo que sobrevive al reinicio
SINGF="${XDG_RUNTIME_DIR:-/run/user/$UID}/cartelitos-sing"

# El binario de Quickshell: `qs` en Arch, `quickshell` en las distros que sólo traen ese nombre.
qs_bin() {
    command -v qs 2>/dev/null || command -v quickshell 2>/dev/null
}

# Un PID vivo no alcanza: el sistema recicla números, y con el pidfile de una
# sesión anterior `kill -0` daba OK sobre un proceso ajeno — status decía ON sin
# nada corriendo y stop le mandaba la señal a otro. Se confirma el cmdline, igual
# que _daemon_pid() del lado de Python.
running() {
    local pidfile="$1" want="$2" pid
    [ -f "$pidfile" ] || return 1
    pid=$(cat "$pidfile" 2>/dev/null)
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    # sin /proc no hay con qué confirmar: queda el kill -0 de antes
    [ -n "$want" ] && [ -r "/proc/$pid/cmdline" ] || return 0
    local cmd
    cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline")
    # entre el fork y el exec el cmdline está VACÍO (y en un zombie también):
    # exigirlo ahí haría que `fatal on; fatal status` dijera OFF con el proceso
    # arrancando bien. El chequeo es contra PIDs reciclados, no contra los recién
    # nacidos: sin cmdline vale el kill -0.
    [ -n "$cmd" ] || return 0
    printf '%s' "$cmd" | grep -qF -- "$want"
}

# UN backup, siempre, antes de abrir el archivo de la sesión nueva (renombrar y
# listo). Antes rotaba sólo si pasaba los 5 MB: un log de pocos KB con warnings
# de diez restarts viejos nunca llegaba a ese tamaño y no rotaba nunca, así que
# cada `fatal restart` mezclaba warnings de la sesión anterior (o de un
# `shell.qml` a medio editar que hot-recargó) con los de la sesión que arranca
# — falso positivo/negativo en cualquier `grep "crt:" qs.log` después de un
# restart. Ya en marcha rota el propio daemon truncando el mismo inodo (por
# eso spawn() usa `>>`: en append el truncado no deja un agujero); esto es
# sólo el corte entre sesión vieja y sesión nueva.
rotate_log() {
    local f="$1"
    [ -f "$f" ] || return 0
    mv -f "$f" "$f.1"
    return 0
}

# Lanza en una sesión propia: un `cmd &` pelado se muere junto con la shell que
# lo largó (terminal que cerrás, script que termina, autostart efímero), y el
# overlay se caía calladito sin dejar ni una línea de log. `setsid` lo saca de
# ese árbol; el PID lo escribe el propio hijo antes del exec porque setsid puede
# forkear y ahí `$!` apunta al padre equivocado.
#
# Con LOCKFILE (sólo el overlay) lo lanza un wrapper que toma un flock en el fd 9,
# anota su PID en el archivo del lock y corre qs SIN ese fd (`9>&-`): el lock
# pertenece al wrapper, no a lo que cuelgue de qs. Antes el fd se heredaba a todos
# los hijos y `fatal stop` (fuser -k sobre el lock) se llevaba puesto cualquier
# proceso que qs lanzara — un navegador, un xdg-open — aunque fuera una app de
# Ferox. El wrapper queda vivo mientras haya un `qs|quickshell` en su sesión: el
# crash handler de Quickshell (ver TRAMPAS, "Procesos huérfanos") relanza el
# shell tras un SIGSEGV con un `quickshell` que no figura en qs.pid, y ese
# relanzado (y el reporter del crash) nacen en la sesión del wrapper. Así siguen
# contando como INSTANCIA sin que nadie herede un fd. qs.pid guarda el PID de qs
# (el wrapper primero, hasta que lo lanza).
spawn() {
    local pidfile="$1" logfile="$2"
    shift 2
    PIDFILE="$pidfile" LOGFILE="$logfile" LOCKFILE="${LOCKFILE:-}" setsid sh -c '
        if [ -n "$LOCKFILE" ]; then
            exec 9>>"$LOCKFILE"
            flock -n 9 || { echo "another instance holds $LOCKFILE, not starting" >&2; exit 75; }
            # el wrapper vive tanto como el shell: que no retenga el stdout de quien lo lanzó
            exec >>"$LOGFILE" 2>&1
            echo $$ > "$LOCKFILE"; echo $$ > "$PIDFILE"
            stopping=
            trap "stopping=1; kill \$c 2>/dev/null" TERM INT HUP
            "$@" 9>&- &
            c=$!
            echo $c > "$PIDFILE"
            while kill -0 $c 2>/dev/null; do wait $c; done
            while [ -z "$stopping" ] && pgrep -s $$ -x "qs|quickshell" >/dev/null 2>&1; do sleep 1; done
            exit 0
        fi
        echo $$ > "$PIDFILE"; exec "$@" >>"$LOGFILE" 2>&1' sh "$@" &
}

# ¿hay alguien con el lock tomado? (0 = sí). Se prueba tomándolo un instante.
lock_held() {
    [ -e "$1" ] || return 1
    ! ( flock -n 8 ) 8>>"$1" 2>/dev/null
}

# El PID que anotó el dueño del lock (vacío si no hay).
lock_holder() {
    local pid
    pid=$(cat "$1" 2>/dev/null)
    case "$pid" in ''|*[!0-9]*) return 0 ;; esac
    echo "$pid"
}

# Los `qs|quickshell` que sobreviven en la sesión de un wrapper que ya murió (su
# PID ya no existe, así que el número de sesión no puede ser de otro).
lock_orphans() {
    local pid
    [ "$1" = "$QS_LOCK" ] || return 0
    pid=$(lock_holder "$1")
    [ -n "$pid" ] || return 0
    kill -0 "$pid" 2>/dev/null && return 0
    pgrep -s "$pid" -x "qs|quickshell" 2>/dev/null || true
}

# ¿hay una instancia que cuente? El lock tomado, o huérfanos de un wrapper caído.
instance_busy() {
    lock_held "$1" || [ -n "$(lock_orphans "$1")" ]
}

# Los PIDs a bajar de una instancia: el dueño del lock (si el cmdline confirma que
# es lo que esperamos — el nombre del archivo, no la ruta: puede ser la copia de
# otro checkout —, contra PIDs reciclados) y, si es el overlay, los
# `qs|quickshell` de su sesión. Nada por fd: lo que qs lance y no sea quickshell
# (un navegador, una app) no se toca.
lock_targets() {
    local lock="$1" want="$2" pid cmd
    pid=$(lock_holder "$lock")
    [ -n "$pid" ] || return 0
    if kill -0 "$pid" 2>/dev/null; then
        cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
        if [ -n "$cmd" ] && ! printf '%s' "$cmd" | grep -qF -- "$want"; then
            return 0    # PID reciclado: no es de nadie nuestro
        fi
        echo "$pid"
    fi
    # vivo y confirmado, o muerto (y entonces el número de sesión no es de otro)
    [ "$lock" = "$QS_LOCK" ] && pgrep -s "$pid" -x "qs|quickshell" 2>/dev/null
    return 0
}

# Baja a la instancia: TERM, hasta 2 s de gracia, después KILL.
lock_kill() {
    local lock="$1" want="$2" pids _
    instance_busy "$lock" || return 0
    pids=$(lock_targets "$lock" "$want")
    [ -n "$pids" ] && kill -TERM $pids 2>/dev/null
    for _ in $(seq 1 10); do
        instance_busy "$lock" || return 0
        sleep 0.2
    done
    pids=$(lock_targets "$lock" "$want")
    [ -n "$pids" ] && kill -KILL $pids 2>/dev/null
    sleep 0.2
    return 0
}

# Rechazo de `start`: dice quién lo tiene y qué hacer, y NO toca el pidfile.
refuse() {
    local what="$1" lock="$2" pid
    pid=$(lock_holder "$lock")
    echo "fatal: another $what is already running (pid ${pid:-?}) and it is not the one in the pidfile." >&2
    echo "       run 'fatal stop' (or 'fatal restart') to take it down first." >&2
}

# El daemon y el overlay son dos procesos y se mueren por separado: si una
# actualización reemplaza los binarios en caliente, el overlay se cae solo y el
# daemon sigue mandando letras a una pantalla que ya no existe. Mirar un PID
# solo hacía que `status` dijera ON con medio programa muerto y que `toggle`
# apagara lo poco que quedaba en vez de levantarlo.
status_line() {
    if running "$D_PID" "$DAEMON" && running "$QS_PID" "$QML"; then
        echo ON
    elif running "$D_PID" "$DAEMON"; then
        echo "HALF (the overlay died — run: fatal restart)"
    elif running "$QS_PID" "$QML"; then
        echo "HALF (the daemon died — run: fatal restart)"
    else
        echo OFF
    fi
    # con el daemon apagado el archivo es del tema de la sesión anterior: no
    # dice nada de ahora y confunde más de lo que informa
    running "$D_PID" "$DAEMON" && [ -f "$LYRICS" ] && cat "$LYRICS"
    # el modo karaoke cambia lo que se ve entero (todo apagado hasta que
    # cantás): si está puesto, tiene que decirlo — si no, parece que se rompió
    echo "sing: $(sing_state)"
    echo "crt: $(crt_state)"
    # qué falta instalar y qué función se pierde por cada cosa: no imprime nada
    # si está todo. Sin esto, media app apagada parecía un bug.
    [ -f "$DAEMON" ] && python3 "$DAEMON" --check 2>/dev/null
    return 0
}

start() {
    if [ ! -f "$QML" ] || [ ! -f "$DAEMON" ]; then
        echo "can't find the fatal-lyrics files in $BASE" >&2
        exit 1
    fi
    if ! running "$QS_PID" "$QML"; then
        if instance_busy "$QS_LOCK"; then
            refuse "overlay" "$QS_LOCK"
            return 1
        fi
        QS=$(qs_bin) || {
            echo "fatal: missing dependency: Quickshell (neither 'qs' nor 'quickshell' is in the PATH)" >&2
            return 1
        }
        rotate_log "$QS_LOG"
        LOCKFILE="$QS_LOCK" spawn "$QS_PID" "$QS_LOG" "$QS" -p "$QML"
    fi
    # wait for the overlay to bring up the socket before starting the daemon
    for _ in $(seq 1 25); do
        [ -S "$SOCK" ] && break
        sleep 0.2
    done
    if ! running "$D_PID" "$DAEMON"; then
        if instance_busy "$D_LOCK"; then
            refuse "daemon" "$D_LOCK"
            return 1
        fi
        rotate_log "$D_LOG"
        rm -f "$D_READY" "$D_PID"   # sin pidfile viejo: el spawn lo escribe recién en su subshell
        spawn "$D_PID" "$D_LOG" python3 "$DAEMON"
        # el daemon escribe el flag del CRT al arrancar: si volvemos antes, un
        # `fatal crt on` inmediato se pisa con el valor de la config. Espera
        # acotada (10 s) y corta si el daemon murió.
        for _ in $(seq 1 50); do
            [ -e "$D_READY" ] && break
            [ -f "$D_PID" ] && ! running "$D_PID" "$DAEMON" && break
            sleep 0.2
        done
    fi
    # "ON" sólo si las DOS mitades siguen vivas: antes se imprimía igual con el
    # overlay muerto (sin qs, QML roto) y la pantalla quedaba vacía sin explicación
    if ! { running "$QS_PID" "$QML" || instance_busy "$QS_LOCK"; }; then
        start_failed "overlay" "$QS_LOG"
        return 1
    fi
    if ! running "$D_PID" "$DAEMON"; then
        start_failed "daemon" "$D_LOG"
        return 1
    fi
    echo "fatal ON"
}

# Dice cuál mitad no arrancó, la última línea de su log (suele ser el motivo) y
# dónde mirar el resto.
start_failed() {
    local what="$1" log="$2" last
    echo "fatal: the $what didn't start — see $log" >&2
    last=$(tail -n 1 "$log" 2>/dev/null)
    [ -n "$last" ] && echo "       last line: $last" >&2
    return 0
}

stop() {
    running "$D_PID" "$DAEMON" && kill "$(cat "$D_PID")" 2>/dev/null
    running "$QS_PID" "$QML" && kill "$(cat "$QS_PID")" 2>/dev/null
    # lo que el pidfile no conoce pero figura en el lock: el `quickshell` que
    # relanzó el crash handler, su reporter, un daemon de otra copia del repo
    lock_kill "$QS_LOCK" "shell.qml"
    lock_kill "$D_LOCK" "cartelitos.py"
    rm -f "$D_PID" "$QS_PID" "$D_READY"
    # una instancia levantada por la versión anterior dejó el PID en /tmp:
    # sin esto quedaba corriendo para siempre, invisible para el nuevo status
    # ojo: por el mismo camino que los de ahora, con confirmación de cmdline —
    # un PID viejo de /tmp es justamente el caso más probable de número reciclado
    running "$OLD_D_PID" cartelitos.py && kill "$(cat "$OLD_D_PID")" 2>/dev/null
    running "$OLD_QS_PID" shell.qml && kill "$(cat "$OLD_QS_PID")" 2>/dev/null
    rm -f "$OLD_D_PID" "$OLD_QS_PID"
    # without this, the next start sees the stale socket and starts the daemon too early
    rm -f "$SOCK"
    rm -f "$LYRICS"                   # sin daemon no hay letra de la que informar
    printf '0' > "$CRT" 2>/dev/null   # que no quede el tubo prendido en el archivo
    rm -f "$CRT_SETUP"                # ni los números de pantalla de la sesión pasada
    rm -f "$SINGF"                    # ni el timbre del karaoke

    echo "fatal OFF"
}

# `stop` apaga el archivo del CRT a propósito (no dejar el tubo prendido en un
# fatal-lyrics completamente apagado). Pero `restart` es "estado limpio,
# seguir andando", no "apagar funciones": sin esto, el autostart de
# `execs.conf` (que hace `cartelitos restart` en cada boot) apagaba el modo
# CRT en cada arranque aunque Ferox lo hubiera dejado prendido. El archivo
# admite `watchChanges`, así que escribirlo después de `start` lo levanta en
# caliente sin flash de "apagado".
restart() {
    local crt_prev
    crt_prev=$(cat "$CRT" 2>/dev/null)
    stop
    sleep 0.5
    start || return 1
    [ -n "$crt_prev" ] && crt_set "$crt_prev" >/dev/null
    return 0
}

# --- la unit de systemd (packaging/fatal-lyrics.service) ----------------------
# Con la unit instalada, `on`, `off` y `restart` pasan por `systemctl --user`:
# así el shell de Ferox (Configuración, Apps de inicio) y la terminal hablan de
# la MISMA instancia, y los procesos quedan dentro del cgroup de la unit en vez
# de en el de la terminal que los lanzó. Sin la unit (otro compositor, sin
# systemd, el paquete sin instalar) todo sigue como siempre, a mano.
# Ojo: `stop` (la función) es el apagado a mano y NO pasa por la unit: es lo
# que corre `run` adentro de ella. La puerta de la línea de comandos es cmd_*.
UNIT=fatal-lyrics.service

unit_known() {
    # FATAL_NO_UNIT: los tests (y quien pruebe otra copia del repo) no tienen
    # que tocar la instancia real de la sesión a través de la unit
    [ -z "${FATAL_NO_UNIT:-}" ] || return 1
    command -v systemctl >/dev/null 2>&1 &&
        systemctl --user cat "$UNIT" >/dev/null 2>&1
}

unit_active() {
    systemctl --user -q is-active "$UNIT" 2>/dev/null
}

# La unit vuelve recién cuando `run` avisó READY, o sea con los dos procesos
# arriba (ver start: espera el flag del CRT del daemon).
unit_start() {
    if systemctl --user start "$UNIT"; then
        # `start` devuelve 0 aunque la unit se salte sola por su Condition (sin
        # WAYLAND_DISPLAY en el entorno de systemd --user): ahí no hay nada corriendo
        if ! unit_active; then
            echo "fatal: $UNIT didn't stay up (does systemd --user see WAYLAND_DISPLAY?) — journalctl --user -u $UNIT" >&2
            return 1
        fi
        echo "fatal ON"
    else
        echo "fatal: $UNIT didn't start — journalctl --user -u $UNIT" >&2
        return 1
    fi
}

# `stop` a mano además de la unit: una instancia lanzada por fuera (de antes de
# la unit, otra copia del repo) no está en su cgroup y systemctl no la ve.
cmd_stop() {
    unit_known && unit_active && systemctl --user stop "$UNIT"
    stop
}

cmd_start() {
    if unit_known; then unit_start; else start; fi
}

# Mismo contrato que restart(): estado limpio y el tubo como estaba.
cmd_restart() {
    local crt_prev
    unit_known || { restart; return; }
    crt_prev=$(cat "$CRT" 2>/dev/null)
    cmd_stop >/dev/null
    sleep 0.5
    unit_start || return 1
    [ -n "$crt_prev" ] && crt_set "$crt_prev" >/dev/null
    return 0
}

# Hyprland ya tiene monitores. Es lo que esperaba el `sleep 6` del autostart
# viejo (TRAMPAS, "Autostart: un solo exec-once": arrancar en t=0 sin
# monitores rompía el boot), pero mirando la cosa en vez de adivinar cuánto
# tarda. Tope de 20 s: sin hyprctl, o fuera de Hyprland, sigue de largo.
wait_monitors() {
    [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null 2>&1 || return 0
    for _ in $(seq 1 40); do
        hyprctl -j monitors 2>/dev/null | grep -q '"name"' && return 0
        sleep 0.5
    done
    return 0
}

# `fatal run`: el ExecStart de la unit. Arranca (o adopta, si ya hay una
# instancia viva: start no relanza lo que corre) y se queda en primer plano
# mientras estén las DOS mitades — el daemon y el overlay se mueren por
# separado (ver status_line), y con media instancia `run` sale con 1 para que
# Restart=on-failure levante lo que falte. El lock del overlay y no qs.pid:
# el quickshell que relanza el crash handler no figura en el pidfile.
# SIGTERM (systemctl stop, con KillMode=process) baja todo con `stop`, que no
# toca lo que qs haya lanzado (un navegador, un xdg-open).
run() {
    local nap=
    trap 'stop; [ -n "$nap" ] && kill "$nap" 2>/dev/null; exit 0' TERM INT HUP
    wait_monitors
    start || exit 1
    command -v systemd-notify >/dev/null 2>&1 &&
        systemd-notify --ready --pid=$$ 2>/dev/null
    while running "$D_PID" "$DAEMON" && instance_busy "$QS_LOCK"; do
        sleep 2 & nap=$!
        wait "$nap"
    done
    echo "fatal: half of it died ($(status_line | head -1)), letting systemd restart it" >&2
    exit 1
}

# La ventana de Ajustes (shell/settings.qml). Le pasa dónde está todo: la
# ventana le pide a cartelitos.py qué dibujar (`--settings-json`) y llama a este mismo
# binario para el tubo, el sync y la demo. `-n`: si ya hay una abierta, no se
# abre otra encima.
settings() {
    if [ ! -f "$SETTINGS_QML" ]; then
        echo "can't find the settings window in $BASE" >&2
        exit 1
    fi
    FATAL_BIN="$SELF" FATAL_DAEMON="$DAEMON" exec "$(qs_bin || echo qs)" -n -p "$SETTINGS_QML"
}

crt_state() { [ "$(cat "$CRT" 2>/dev/null)" = "1" ] && echo on || echo off; }

# con todo apagado `fatal on` vuelve a [crt] enabled y pisa el archivo (TRAMPAS):
# decir "CRT on" sería mentira. Se avisa y no se escribe nada.
crt_needs_daemon() {
    running "$D_PID" "$DAEMON" && return 0
    echo "fatal-lyrics isn't running — start it with: fatal on (or set [crt] enabled = true)" >&2
    return 1
}

crt_set() {
    [ "$1" = 1 ] && { crt_needs_daemon || return 1; }
    printf '%s' "$1" > "$CRT.tmp" && mv "$CRT.tmp" "$CRT"
    echo "CRT $(crt_state)"
}

# Modo setup: prende el tubo con un número gigante en cada monitor. Se miran de
# izquierda a derecha y ESE es el orden que va en `[crt] order`. Se apaga solo
# al apagar el tubo: un número gigante tapando la pantalla no puede quedar
# colgado porque alguien salió con el mouse.
crt_setup() {
    if [ "${1:-on}" = "off" ]; then
        rm -f "$CRT_SETUP"
        echo "CRT setup off"
        return 0
    fi
    crt_needs_daemon || return 1
    printf '1' > "$CRT_SETUP.tmp" && mv "$CRT_SETUP.tmp" "$CRT_SETUP"
    crt_set 1
    echo "read the numbers left to right — that's your [crt] order"
}

crt() {
    case "${1:-toggle}" in
        on)     crt_set 1 ;;
        off)    rm -f "$CRT_SETUP"; crt_set 0 ;;
        status) crt_state ;;
        setup)  crt_setup "$2" ;;
        # Forzar un dibujo en una pantalla, para MIRARLO — no hace falta que
        # suene el tema con la palabra justa ni rerollear el sorteo. Le habla
        # al socket del overlay, así que no necesita el daemon.
        motif)  shift; python3 "$DAEMON" --crt-motif "$@" ;;
        # Apagar/prender un tubo a mano, para MIRAR el apagado sin esperar a
        # que lo decida una sección o un raro (tanda 6, corrida 0). Mismo
        # camino que `motif`: le habla al socket del overlay, no al daemon.
        dark)   shift; python3 "$DAEMON" --crt-dark "$@" ;;
        # Forzar un evento raro (bsod/nosignal/testcard) en una pantalla, para
        # MIRARLO sin esperar el sorteo de `crt.rare` (tanda 6, corrida 7).
        # Mismo camino: le habla al socket del overlay, no al daemon.
        rare)   shift; python3 "$DAEMON" --crt-rare "$@" ;;
        toggle) [ "$(crt_state)" = "on" ] && { rm -f "$CRT_SETUP"; crt_set 0; } || crt_set 1 ;;
        *)      echo "usage: fatal crt [on|off|toggle|status|setup [off]|motif <kind> [--screen <name|idx|all>]|motif off|dark <screen|idx|all> on|off|rare <kind> [--screen <name|idx|all>]]" >&2; exit 1 ;;
    esac
}

# El estado del modo karaoke es la perilla del TOML, no el timbre de $SINGF:
# este proceso es corto y no puede preguntarle nada al daemon (el socket va
# sólo daemon → overlay), pero el archivo de config sí lo puede leer.
sing_state() {
    grep -qE '^[[:space:]]*sing[[:space:]]*=[[:space:]]*true' "$CONFIG" 2>/dev/null \
        && echo ON || echo OFF
}

# T5.1: el modo karaoke abre el MICRÓFONO, así que no se prende solo por
# accidente: hay que pedirlo. Lo aplica el daemon (config.watch_sing), que es
# quien puede escribir la config y levantar la captura.
sing_lyrics() {
    case "${1:-toggle}" in
        on|off|toggle) ;;
        status) sing_state; return 0 ;;
        *) echo "usage: fatal sing [on|off|toggle|status]" >&2; exit 1 ;;
    esac
    if ! running "$D_PID" "$DAEMON"; then
        echo "fatal-lyrics isn't running — start it with: fatal on" >&2
        exit 1
    fi
    printf '%s' "$1" > "$SINGF.tmp" && mv "$SINGF.tmp" "$SINGF"
    echo "sing $1"
}

demo() {
    if running "$D_PID" "$DAEMON"; then
        kill -USR1 "$(cat "$D_PID")"
    else
        echo "fatal-lyrics isn't running — start it with: fatal on" >&2
        exit 1
    fi
}

# T0.13: el daemon vivo lee esto con DaemonLoop._watch_sync (mismo mecanismo
# de archivo que crt/tune) y ajusta el offset del tema que está sonando ya.
sync_lyrics() {
    # `show` y `reset` NO necesitan el daemon: lo aprendido vive en
    # offsets.toml, así que se mira y se borra con todo apagado. Sólo el
    # ajuste en vivo (+/-) tiene que llegarle a un daemon que esté corriendo.
    case "${1:-}" in
        show)  python3 "$DAEMON" --sync-show; return $? ;;
        reset) python3 "$DAEMON" --sync-reset "${2:-}"; return $? ;;
        -) d=-0.1 ;;
        +) d=0.1 ;;
        *) echo "usage: fatal sync [+|-|show|reset [<artist>|all]]" >&2; exit 1 ;;
    esac
    if ! running "$D_PID" "$DAEMON"; then
        echo "fatal-lyrics isn't running — start it with: fatal on" >&2
        exit 1
    fi
    printf '%s' "$d" > "$SYNCF.tmp" && mv "$SYNCF.tmp" "$SYNCF"
}

# `fatal help` lo imprime por stdout; un comando que no existe, por stderr con exit 1
usage() {
    cat <<'EOF'
usage: fatal [command]
  on | off | toggle | restart | status      (no command = toggle)
  ajustes                                   the Settings window: every option
  edit                                      open config.toml in $EDITOR
  demo                                      fake dialogs, no music needed
  crt on | off | toggle | status            the CRT tube
  crt setup [off]                           a number on each screen, for [crt] order
  crt motif <kind> [--screen <name|idx|all>] | motif off
  crt dark <screen|idx|all> on|off
  crt rare <kind> [--screen <name|idx|all>]
  sync + | - | show | reset [<artist>|all]  lyric timing
  sing on | off | toggle | status           karaoke mode
  help                                      this text
EOF
}

case "${1:-toggle}" in
    on|start)  cmd_start ;;
    off|stop)  cmd_stop ;;
    restart)   cmd_restart ;;
    run)       run ;;
    status)    status_line ;;
    # medio muerto cuenta como apagado: así el toggle lo levanta entero en vez
    # de rematar la mitad que seguía viva
    toggle)    running "$D_PID" "$DAEMON" && running "$QS_PID" "$QML" && cmd_stop || cmd_start ;;
    edit)      ${EDITOR:-nano} "$CONFIG" ;;
    demo)      demo ;;
    # con "$@" y no con "$2" "$3": `crt motif <kind> --screen <n>` son cuatro
    crt)       shift; crt "$@" ;;
    sync)      sync_lyrics "$2" "$3" ;;
    sing)      sing_lyrics "$2" ;;
    # todas las opciones viven en la ventana de Ajustes: `config` y `setup`
    # (el menú de terminal que había antes) abren la ventana
    ajustes|settings|config|setup|tune|sliders) settings ;;
    help|-h|--help) usage ;;
    *)         usage >&2; exit 1 ;;
esac
