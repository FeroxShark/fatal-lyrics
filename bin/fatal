#!/bin/bash
# fatal-lyrics — synced Spotify lyrics as Windows error dialogs.
# Relocatable: works from the cloned repo or installed at /usr/share/fatal-lyrics.
SELF="$(readlink -f "$0")"
BASE="${CARTELITOS_HOME:-$(dirname "$(dirname "$SELF")")}"
QML="$BASE/shell/shell.qml"
TUNE_QML="$BASE/shell/tune.qml"
DAEMON="$BASE/cartelitos.py"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/cartelitos/config.toml"

QS_PID=/tmp/cartelitos-qs.pid
D_PID=/tmp/cartelitos-daemon.pid
SOCK="${XDG_RUNTIME_DIR:-/run/user/$UID}/cartelitos.sock"
# interruptor del modo CRT: un archivo, no el socket — apagarlo tiene que
# funcionar aunque el daemon esté colgado (el tubo tapa todas las pantallas)
CRT="${XDG_RUNTIME_DIR:-/run/user/$UID}/cartelitos-crt"

running() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }

# Lanza en una sesión propia: un `cmd &` pelado se muere junto con la shell que
# lo largó (terminal que cerrás, script que termina, autostart efímero), y el
# overlay se caía calladito sin dejar ni una línea de log. `setsid` lo saca de
# ese árbol; el PID lo escribe el propio hijo antes del exec porque setsid puede
# forkear y ahí `$!` apunta al padre equivocado.
spawn() {
    local pidfile="$1" logfile="$2"
    shift 2
    PIDFILE="$pidfile" LOGFILE="$logfile" setsid sh -c \
        'echo $$ > "$PIDFILE"; exec "$@" >"$LOGFILE" 2>&1' sh "$@" &
}

# El daemon y el overlay son dos procesos y se mueren por separado: si una
# actualización reemplaza los binarios en caliente, el overlay se cae solo y el
# daemon sigue mandando letras a una pantalla que ya no existe. Mirar un PID
# solo hacía que `status` dijera ON con medio programa muerto y que `toggle`
# apagara lo poco que quedaba en vez de levantarlo.
status_line() {
    if running $D_PID && running $QS_PID; then
        echo ON
    elif running $D_PID; then
        echo "HALF (the overlay died — run: fatal restart)"
    elif running $QS_PID; then
        echo "HALF (the daemon died — run: fatal restart)"
    else
        echo OFF
    fi
}

start() {
    if [ ! -f "$QML" ] || [ ! -f "$DAEMON" ]; then
        echo "can't find the fatal-lyrics files in $BASE" >&2
        exit 1
    fi
    if ! running $QS_PID; then
        spawn "$QS_PID" /tmp/cartelitos-qs.log qs -p "$QML"
    fi
    # wait for the overlay to bring up the socket before starting the daemon
    for _ in $(seq 1 25); do
        [ -S "$SOCK" ] && break
        sleep 0.2
    done
    if ! running $D_PID; then
        spawn "$D_PID" /tmp/cartelitos.log python3 "$DAEMON"
    fi
    echo "fatal ON"
}

stop() {
    for f in $D_PID $QS_PID; do
        running "$f" && kill "$(cat "$f")" 2>/dev/null
        rm -f "$f"
    done
    # without this, the next start sees the stale socket and starts the daemon too early
    rm -f "$SOCK"
    printf '0' > "$CRT" 2>/dev/null   # que no quede el tubo prendido en el archivo

    echo "fatal OFF"
}

tune() {
    if [ ! -f "$TUNE_QML" ]; then
        echo "can't find the sliders in $BASE" >&2
        exit 1
    fi
    exec qs -p "$TUNE_QML"
}

crt_state() { [ "$(cat "$CRT" 2>/dev/null)" = "1" ] && echo on || echo off; }

crt_set() {
    printf '%s' "$1" > "$CRT.tmp" && mv "$CRT.tmp" "$CRT"
    echo "CRT $(crt_state)"
}

crt() {
    case "${1:-toggle}" in
        on)     crt_set 1 ;;
        off)    crt_set 0 ;;
        status) crt_state ;;
        toggle) [ "$(crt_state)" = "on" ] && crt_set 0 || crt_set 1 ;;
        *)      echo "usage: fatal crt [on|off|toggle|status]" >&2; exit 1 ;;
    esac
}

demo() {
    if running $D_PID; then
        kill -USR1 "$(cat $D_PID)"
    else
        echo "fatal-lyrics isn't running — start it with: fatal on" >&2
        exit 1
    fi
}

case "${1:-toggle}" in
    on|start)  start ;;
    off|stop)  stop ;;
    restart)   stop; sleep 0.5; start ;;
    status)    status_line ;;
    # medio muerto cuenta como apagado: así el toggle lo levanta entero en vez
    # de rematar la mitad que seguía viva
    toggle)    running $D_PID && running $QS_PID && stop || start ;;
    config|setup) python3 "$DAEMON" --setup ;;
    edit)      ${EDITOR:-nano} "$CONFIG" ;;
    demo)      demo ;;
    crt)       crt "$2" ;;
    tune|sliders) tune ;;
    *)         echo "usage: fatal [on|off|toggle|restart|status|config|edit|demo|tune|crt on|off|toggle]" ;;
esac
