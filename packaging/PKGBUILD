# Maintainer: FeroxShark <feroxshark@gmail.com>
pkgname=fatal-lyrics-git
pkgver=r1.0000000
pkgrel=1
pkgdesc="Synced Spotify lyrics as glitchy Win95 error dialogs, or a full-screen CRT takeover (Wayland overlay)"
arch=('any')
url="https://github.com/FeroxShark/fatal-lyrics"
license=('MIT')
depends=('quickshell' 'playerctl' 'python')
optdepends=('gtk3: ícono de bandeja del sistema' 'libayatana-appindicator: ícono de bandeja del sistema'
            'imagemagick: colores de la tapa del álbum (sin él, el tubo usa sus paletas)')
makedepends=('git')
provides=('fatal-lyrics')
conflicts=('fatal-lyrics')
source=("git+https://github.com/FeroxShark/fatal-lyrics.git")
sha256sums=('SKIP')

pkgver() {
  cd fatal-lyrics
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
  cd fatal-lyrics
  install -d "$pkgdir/usr/share/fatal-lyrics/shell"
  # todo lo que lee el overlay de shell/, por globs (una lista fija dejó afuera Motion.qml, los
  # motifs y la membrana). Los shaders van precompilados (.qsb) y los .frag como fuente; las
  # fuentes OFL de la letra van con sus licencias. tests/test_paquete.py compara con git ls-files
  for f in shell/*.qml shell/*.js shell/*.frag shell/*.vert shell/*.qsb shell/fonts/*; do
    install -Dm644 "$f" "$pkgdir/usr/share/fatal-lyrics/$f"
  done
  install -Dm755 cartelitos.py "$pkgdir/usr/share/fatal-lyrics/cartelitos.py"
  # el código está en el paquete; cartelitos.py sólo delega
  for m in cartelitos/*.py; do
    install -Dm644 "$m" "$pkgdir/usr/share/fatal-lyrics/$m"
  done
  install -Dm755 bin/fatal "$pkgdir/usr/share/fatal-lyrics/bin/fatal"
  install -d "$pkgdir/usr/bin"
  ln -s /usr/share/fatal-lyrics/bin/fatal "$pkgdir/usr/bin/fatal"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 packaging/fatal.desktop "$pkgdir/usr/share/applications/fatal.desktop"
  install -Dm644 packaging/fatal-lyrics.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/fatal-lyrics.svg"
  install -Dm644 packaging/hyprland.lua "$pkgdir/usr/share/fatal-lyrics/packaging/hyprland.lua"
  install -Dm644 packaging/fatal-lyrics.service "$pkgdir/usr/lib/systemd/user/fatal-lyrics.service"
}
