#!/bin/bash
# fatal-lyrics — synced Spotify lyrics as Windows error dialogs.
# Relocatable: works from the cloned repo or installed at /usr/share/fatal-lyrics.
SELF="$(readlink -f "$0")"
BASE="${CARTELITOS_HOME:-$(dirname "$(dirname "$SELF")")}"
QML="$BASE/shell/shell.qml"
TUNE_QML="$BASE/shell/tune.qml"
DAEMON="$BASE/cartelitos.py"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/cartelitos/config.toml"

RUN="${XDG_RUNTIME_DIR:-/run/user/$UID}/cartelitos"
mkdir -p "$RUN" 2>/dev/null
QS_PID="$RUN/qs.pid"
D_PID="$RUN/daemon.pid"
QS_LOG="$RUN/qs.log"
D_LOG="$RUN/daemon.log"
# de dónde salió la letra del tema que suena: lo escribe el daemon (ver
# cartelitos/lyrics.py write_state), porque este proceso es corto y no tiene
# forma de preguntárselo — el socket va sólo del daemon al overlay
LYRICS="$RUN/lyrics"
# dónde vivían los PID antes de mudarlos al runtime: sirven para poder apagar
# una instancia que había arrancado con la versión vieja
OLD_QS_PID=/tmp/cartelitos-qs.pid
OLD_D_PID=/tmp/cartelitos-daemon.pid
LOG_MAX=5242880   # 5 MB, igual que el tope del daemon en cartelitos/util.py
SOCK="${XDG_RUNTIME_DIR:-/run/user/$UID}/cartelitos.sock"
# interruptor del modo CRT: un archivo, no el socket — apagarlo tiene que
# funcionar aunque el daemon esté colgado (el tubo tapa todas las pantallas)
CRT="${XDG_RUNTIME_DIR:-/run/user/$UID}/cartelitos-crt"
# `fatal crt setup`: otro archivo, mismo mecanismo — cada pantalla dibuja su
# número y su nombre, que es lo que hay que escribir en `[crt] order`
CRT_SETUP="${XDG_RUNTIME_DIR:-/run/user/$UID}/cartelitos-crt-setup"
# gesto de sync fino (T0.13): otro archivo, mismo motivo — este proceso es
# corto y se muere, el daemon (otro proceso) es el que tiene que verlo
SYNCF="${XDG_RUNTIME_DIR:-/run/user/$UID}/cartelitos-sync"
# modo karaoke (`fatal sing`): mismo mecanismo de archivo, pero acá el archivo
# es sólo el timbre — el estado vive en la perilla `[behavior] sing` del TOML,
# que es lo que el daemon manda al overlay y lo que sobrevive al reinicio
SINGF="${XDG_RUNTIME_DIR:-/run/user/$UID}/cartelitos-sing"

# Un PID vivo no alcanza: el sistema recicla números, y con el pidfile de una
# sesión anterior `kill -0` daba OK sobre un proceso ajeno — status decía ON sin
# nada corriendo y stop le mandaba la señal a otro. Se confirma el cmdline, igual
# que _daemon_pid() del lado de Python.
running() {
    local pidfile="$1" want="$2" pid
    [ -f "$pidfile" ] || return 1
    pid=$(cat "$pidfile" 2>/dev/null)
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    # sin /proc no hay con qué confirmar: queda el kill -0 de antes
    [ -n "$want" ] && [ -r "/proc/$pid/cmdline" ] || return 0
    local cmd
    cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline")
    # entre el fork y el exec el cmdline está VACÍO (y en un zombie también):
    # exigirlo ahí haría que `fatal on; fatal status` dijera OFF con el proceso
    # arrancando bien. El chequeo es contra PIDs reciclados, no contra los recién
    # nacidos: sin cmdline vale el kill -0.
    [ -n "$cmd" ] || return 0
    printf '%s' "$cmd" | grep -qF -- "$want"
}

# Rotación por tamaño con UN backup, para que un daemon de semanas no llene el
# tmpfs. Acá se rota antes de abrir el archivo (renombrar y listo); ya en marcha
# rota el propio daemon truncando el mismo inodo, porque el redirect lo tiene
# abierto. Por eso spawn() usa `>>`: en append el truncado no deja un agujero.
rotate_log() {
    local f="$1" size
    [ -f "$f" ] || return 0
    size=$(stat -c %s "$f" 2>/dev/null) || return 0
    [ "$size" -gt "$LOG_MAX" ] && mv -f "$f" "$f.1"
    return 0
}

# Lanza en una sesión propia: un `cmd &` pelado se muere junto con la shell que
# lo largó (terminal que cerrás, script que termina, autostart efímero), y el
# overlay se caía calladito sin dejar ni una línea de log. `setsid` lo saca de
# ese árbol; el PID lo escribe el propio hijo antes del exec porque setsid puede
# forkear y ahí `$!` apunta al padre equivocado.
spawn() {
    local pidfile="$1" logfile="$2"
    shift 2
    PIDFILE="$pidfile" LOGFILE="$logfile" setsid sh -c \
        'echo $$ > "$PIDFILE"; exec "$@" >>"$LOGFILE" 2>&1' sh "$@" &
}

# El daemon y el overlay son dos procesos y se mueren por separado: si una
# actualización reemplaza los binarios en caliente, el overlay se cae solo y el
# daemon sigue mandando letras a una pantalla que ya no existe. Mirar un PID
# solo hacía que `status` dijera ON con medio programa muerto y que `toggle`
# apagara lo poco que quedaba en vez de levantarlo.
status_line() {
    if running "$D_PID" "$DAEMON" && running "$QS_PID" "$QML"; then
        echo ON
    elif running "$D_PID" "$DAEMON"; then
        echo "HALF (the overlay died — run: fatal restart)"
    elif running "$QS_PID" "$QML"; then
        echo "HALF (the daemon died — run: fatal restart)"
    else
        echo OFF
    fi
    # con el daemon apagado el archivo es del tema de la sesión anterior: no
    # dice nada de ahora y confunde más de lo que informa
    running "$D_PID" "$DAEMON" && [ -f "$LYRICS" ] && cat "$LYRICS"
    # el modo karaoke cambia lo que se ve entero (todo apagado hasta que
    # cantás): si está puesto, tiene que decirlo — si no, parece que se rompió
    echo "sing: $(sing_state)"
    # qué falta instalar y qué función se pierde por cada cosa: no imprime nada
    # si está todo. Sin esto, media app apagada parecía un bug.
    [ -f "$DAEMON" ] && python3 "$DAEMON" --check 2>/dev/null
    return 0
}

start() {
    if [ ! -f "$QML" ] || [ ! -f "$DAEMON" ]; then
        echo "can't find the fatal-lyrics files in $BASE" >&2
        exit 1
    fi
    if ! running "$QS_PID" "$QML"; then
        rotate_log "$QS_LOG"
        spawn "$QS_PID" "$QS_LOG" qs -p "$QML"
    fi
    # wait for the overlay to bring up the socket before starting the daemon
    for _ in $(seq 1 25); do
        [ -S "$SOCK" ] && break
        sleep 0.2
    done
    if ! running "$D_PID" "$DAEMON"; then
        rotate_log "$D_LOG"
        spawn "$D_PID" "$D_LOG" python3 "$DAEMON"
    fi
    echo "fatal ON"
}

stop() {
    running "$D_PID" "$DAEMON" && kill "$(cat "$D_PID")" 2>/dev/null
    running "$QS_PID" "$QML" && kill "$(cat "$QS_PID")" 2>/dev/null
    rm -f "$D_PID" "$QS_PID"
    # una instancia levantada por la versión anterior dejó el PID en /tmp:
    # sin esto quedaba corriendo para siempre, invisible para el nuevo status
    # ojo: por el mismo camino que los de ahora, con confirmación de cmdline —
    # un PID viejo de /tmp es justamente el caso más probable de número reciclado
    running "$OLD_D_PID" cartelitos.py && kill "$(cat "$OLD_D_PID")" 2>/dev/null
    running "$OLD_QS_PID" shell.qml && kill "$(cat "$OLD_QS_PID")" 2>/dev/null
    rm -f "$OLD_D_PID" "$OLD_QS_PID"
    # without this, the next start sees the stale socket and starts the daemon too early
    rm -f "$SOCK"
    rm -f "$LYRICS"                   # sin daemon no hay letra de la que informar
    printf '0' > "$CRT" 2>/dev/null   # que no quede el tubo prendido en el archivo
    rm -f "$CRT_SETUP"                # ni los números de pantalla de la sesión pasada
    rm -f "$SINGF"                    # ni el timbre del karaoke

    echo "fatal OFF"
}

tune() {
    if [ ! -f "$TUNE_QML" ]; then
        echo "can't find the sliders in $BASE" >&2
        exit 1
    fi
    exec qs -p "$TUNE_QML"
}

crt_state() { [ "$(cat "$CRT" 2>/dev/null)" = "1" ] && echo on || echo off; }

crt_set() {
    printf '%s' "$1" > "$CRT.tmp" && mv "$CRT.tmp" "$CRT"
    echo "CRT $(crt_state)"
}

# Modo setup: prende el tubo con un número gigante en cada monitor. Se miran de
# izquierda a derecha y ESE es el orden que va en `[crt] order`. Se apaga solo
# al apagar el tubo: un número gigante tapando la pantalla no puede quedar
# colgado porque alguien salió con el mouse.
crt_setup() {
    if [ "${1:-on}" = "off" ]; then
        rm -f "$CRT_SETUP"
        echo "CRT setup off"
        return 0
    fi
    printf '1' > "$CRT_SETUP.tmp" && mv "$CRT_SETUP.tmp" "$CRT_SETUP"
    crt_set 1
    echo "read the numbers left to right — that's your [crt] order"
}

crt() {
    case "${1:-toggle}" in
        on)     crt_set 1 ;;
        off)    rm -f "$CRT_SETUP"; crt_set 0 ;;
        status) crt_state ;;
        setup)  crt_setup "$2" ;;
        toggle) [ "$(crt_state)" = "on" ] && { rm -f "$CRT_SETUP"; crt_set 0; } || crt_set 1 ;;
        *)      echo "usage: fatal crt [on|off|toggle|status|setup [off]]" >&2; exit 1 ;;
    esac
}

# El estado del modo karaoke es la perilla del TOML, no el timbre de $SINGF:
# este proceso es corto y no puede preguntarle nada al daemon (el socket va
# sólo daemon → overlay), pero el archivo de config sí lo puede leer.
sing_state() {
    grep -qE '^[[:space:]]*sing[[:space:]]*=[[:space:]]*true' "$CONFIG" 2>/dev/null \
        && echo ON || echo OFF
}

# T5.1: el modo karaoke abre el MICRÓFONO, así que no se prende solo por
# accidente: hay que pedirlo. Lo aplica el daemon (config.watch_sing), que es
# quien puede escribir la config y levantar la captura.
sing_lyrics() {
    case "${1:-toggle}" in
        on|off|toggle) ;;
        status) sing_state; return 0 ;;
        *) echo "usage: fatal sing [on|off|toggle|status]" >&2; exit 1 ;;
    esac
    if ! running "$D_PID" "$DAEMON"; then
        echo "fatal-lyrics isn't running — start it with: fatal on" >&2
        exit 1
    fi
    printf '%s' "$1" > "$SINGF.tmp" && mv "$SINGF.tmp" "$SINGF"
    echo "sing $1"
}

demo() {
    if running "$D_PID" "$DAEMON"; then
        kill -USR1 "$(cat "$D_PID")"
    else
        echo "fatal-lyrics isn't running — start it with: fatal on" >&2
        exit 1
    fi
}

# T0.13: el daemon vivo lee esto con DaemonLoop._watch_sync (mismo mecanismo
# de archivo que crt/tune) y ajusta el offset del tema que está sonando ya.
sync_lyrics() {
    # `show` y `reset` NO necesitan el daemon: lo aprendido vive en
    # offsets.toml, así que se mira y se borra con todo apagado. Sólo el
    # ajuste en vivo (+/-) tiene que llegarle a un daemon que esté corriendo.
    case "${1:-}" in
        show)  python3 "$DAEMON" --sync-show; return $? ;;
        reset) python3 "$DAEMON" --sync-reset "${2:-}"; return $? ;;
        -) d=-0.1 ;;
        +) d=0.1 ;;
        *) echo "usage: fatal sync [+|-|show|reset [<artist>|all]]" >&2; exit 1 ;;
    esac
    if ! running "$D_PID" "$DAEMON"; then
        echo "fatal-lyrics isn't running — start it with: fatal on" >&2
        exit 1
    fi
    printf '%s' "$d" > "$SYNCF.tmp" && mv "$SYNCF.tmp" "$SYNCF"
}

case "${1:-toggle}" in
    on|start)  start ;;
    off|stop)  stop ;;
    restart)   stop; sleep 0.5; start ;;
    status)    status_line ;;
    # medio muerto cuenta como apagado: así el toggle lo levanta entero en vez
    # de rematar la mitad que seguía viva
    toggle)    running "$D_PID" "$DAEMON" && running "$QS_PID" "$QML" && stop || start ;;
    config|setup) python3 "$DAEMON" --setup ;;
    edit)      ${EDITOR:-nano} "$CONFIG" ;;
    demo)      demo ;;
    crt)       crt "$2" "$3" ;;
    sync)      sync_lyrics "$2" "$3" ;;
    sing)      sing_lyrics "$2" ;;
    tune|sliders) tune ;;
    *)         echo "usage: fatal [on|off|toggle|restart|status|config|edit|demo|tune|crt on|off|toggle|setup|sync +|-|show|reset [<artist>|all]|sing on|off|toggle]" ;;
esac
